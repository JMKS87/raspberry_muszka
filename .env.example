# Skopiuj do .env i dostosuj:  cp .env.example .env

# --- Obraz llama.cpp ---------------------------------------------------------
# Zalecane: przypnij konkretny build, np. ghcr.io/ggml-org/llama.cpp:server-b1234
# (lista tagów: https://github.com/ggml-org/llama.cpp/pkgs/container/llama.cpp)
LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server

# --- Model -------------------------------------------------------------------
MODEL_FILE=muszka-instruct-1.5b-v1.0-Q6_K.gguf

# --- Sieć --------------------------------------------------------------------
# Adres, na którym Pi wystawia port. 0.0.0.0 = wszystkie interfejsy (LAN).
# Możesz podać IP konkretnego interfejsu, np. 192.168.1.50.
BIND_ADDRESS=0.0.0.0
MUSZKA_PORT=8080

# Klucz do API (nagłówek "Authorization: Bearer <klucz>").
# Pusty = brak autoryzacji. Wygeneruj np.:  openssl rand -hex 24
API_KEY=

# --- Wydajność ---------------------------------------------------------------
# Liczba wątków CPU. Autor modelu: na Pi 5 najszybciej -t 2 (limit przepustowości RAM).
# Sprawdź u siebie:  bash scripts/bench.sh
THREADS=2

# Liczba równoległych użytkowników / zapytań (sloty serwera).
# Każdy slot dostaje własny kontekst CTX_PER_SLOT, więc RAM na KV cache rośnie liniowo.
# Na Pi 5 8GB spokojnie zmieści się kilka slotów, ale CPU dzieli się między nie
# (2 równoczesne zapytania ≈ każde ~2x wolniejsze).
PARALLEL=2

# Kontekst na jeden slot (tokeny). Model był trenowany na 8192 — nie przekraczaj.
CTX_PER_SLOT=8192

# Limit pamięci kontenera.
MEM_LIMIT=4g

# --- Domyślne próbkowanie (klient API może nadpisać per zapytanie) ------------
TEMPERATURE=0.2
TOP_P=0.9
REPEAT_PENALTY=1.05
